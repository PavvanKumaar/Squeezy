# Copy this to .env and fill in your values
# NEVER commit .env — only commit .env.template

# PostgreSQL (TimescaleDB)
POSTGRES_URL=postgresql://admin:password@localhost:5432/squeezradar
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=squeezradar
POSTGRES_USER=admin
POSTGRES_PASSWORD=password

# MongoDB
MONGO_URL=mongodb://localhost:27017
MONGO_DB=squeezradar

# Redis
REDIS_URL=redis://localhost:6379

# Cassandra
CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=squeezradar

# Elasticsearch
ELASTIC_URL=http://localhost:9200

# Reddit API
# Get from: reddit.com/prefs/apps → create app → script
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=SqueezeRadar/1.0 by YourRedditUsername

# StockTwits (optional for now)
STOCKTWITS_TOKEN=your_token_here

# News API
# Get from: newsapi.org (free tier)
NEWS_API_KEY=your_key_here

# Model config
MODEL_VERSION=v1.0
ENVIRONMENT=development